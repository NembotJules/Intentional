{
  "name": "intentional-expo",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "postinstall": "node scripts/patch-metro-node18.js && node scripts/patch-css-interop-metro.js",
    "prestart": "node -e \"const v=process.versions.node.split('.').map(Number);if(v[0]<20){console.error('\\nNativeWind requires Node 20+. You have Node '+process.versions.node+'. Run: nvm use 20 (or install Node 20).\\n');process.exit(1);}\"",
    "start": "expo start --tunnel",
    "prego": "node -e \"const v=process.versions.node.split('.').map(Number);if(v[0]<20){console.error('\\nNativeWind requires Node 20+. You have Node '+process.versions.node+'. Run: nvm use 20 (or install Node 20).\\n');process.exit(1);}\"",
    "go": "npm run prego && expo start --tunnel",
    "start:offline": "expo start --tunnel --offline",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "e2e": "node e2e/run.mjs",
    "verify": "npm run typecheck && npm test && npm run verify:migrations",
    "verify:migrations": "python3 scripts/verify-migrations.py",
    "test:rls": "node scripts/test-rls.mjs",
    "supabase:push": "node scripts/supabase-push.mjs",
    "supabase:types": "node scripts/supabase-types.mjs",
    "test:sync": "SYNC_LIVE=1 vitest run services/sync.live.test.ts"
  },
  "engines": {
    "node": ">=20.19.4"
  },
  "dependencies": {
    "@bacons/apple-targets": "^5.0.0",
    "@expo-google-fonts/ibm-plex-mono": "^0.4.1",
    "@expo-google-fonts/instrument-serif": "^0.4.1",
    "@expo-google-fonts/source-sans-3": "^0.4.1",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.0.0",
    "@supabase/supabase-js": "^2.109.0",
    "expo": "^58",
    "expo-apple-authentication": "~58.0.2",
    "expo-blur": "~58.0.5",
    "expo-constants": "~58.0.13",
    "expo-file-system": "~58.0.12",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.14",
    "expo-media-library": "~58.0.12",
    "expo-notifications": "~58.1.6",
    "expo-router": "~58.0.27",
    "expo-sharing": "~58.0.20",
    "expo-splash-screen": "~58.0.11",
    "expo-sqlite": "~58.0.14",
    "family-controls": "./modules/family-controls",
    "lucide-react-native": "^1.56.0",
    "nativewind": "^4.2.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-view-shot": "6.1.1",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "@types/ws": "^8.18.2",
    "playwright": "^1.63.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.5",
    "ws": "^8.22.1"
  },
  "private": true
}
