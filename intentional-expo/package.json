{
  "name": "intentional-expo",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "postinstall": "node scripts/patch-metro-node18.js",
    "prestart": "node -e \"const v=process.versions.node.split('.').map(Number);if(v[0]<20){console.error('\\nNativeWind requires Node 20+. You have Node '+process.versions.node+'. Run: nvm use 20 (or install Node 20).\\n');process.exit(1);}\"",
    "start": "expo start --tunnel",
    "prego": "node -e \"const v=process.versions.node.split('.').map(Number);if(v[0]<20){console.error('\\nNativeWind requires Node 20+. You have Node '+process.versions.node+'. Run: nvm use 20 (or install Node 20).\\n');process.exit(1);}\"",
    "go": "npm run prego && expo start --tunnel",
    "start:offline": "expo start --tunnel --offline",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20.19.4"
  },
  "dependencies": {
    "@expo-google-fonts/ibm-plex-mono": "^0.4.1",
    "@expo-google-fonts/instrument-serif": "^0.4.1",
    "@expo-google-fonts/source-sans-3": "^0.4.1",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.0.0",
    "expo": "^57",
    "expo-blur": "~57.0.2",
    "expo-constants": "~57.0.17",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.2",
    "expo-linking": "~57.0.9",
    "expo-media-library": "~57.0.4",
    "expo-notifications": "~57.0.17",
    "expo-router": "~57.0.19",
    "expo-sharing": "~57.0.18",
    "expo-splash-screen": "~57.0.8",
    "expo-sqlite": "~57.0.2",
    "family-controls": "./modules/family-controls",
    "nativewind": "^4.2.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "*",
    "react-native-worklets": "0.10.1",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "typescript": "~6.0.3",
    "vitest": "^4.1.5"
  },
  "private": true
}
