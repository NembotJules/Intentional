# Copy to .env (git-ignored) and fill in. Without these the app runs local-only (no accounts, no backup).
# Safe for the app: the URL and the anon (publishable) key. NEVER put the service-role key here.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon key>
