{
  "expo": {
    "name": "Intentional",
    "slug": "intentional",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "intentional",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.intentional.app"
    },
    "android": {
      "package": "com.intentional.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFE8D2",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "backgroundColor": "#FFF8F6",
      "themeColor": "#FF6A2B"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#FF6A2B",
          "sounds": []
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Intentional to save goal wallpapers to your photo library.",
          "savePhotosPermission": "Allow Intentional to save goal wallpapers to your photo library.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "./plugins/withFamilyControls",
      "@bacons/apple-targets",
      "expo-font",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFF8F6"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
